"""The experimental locality index: hand-computed on five fictional gminas (RM-439).

LEGAL[third-party-data]: invented statistics shaped like BDL's; no network and no real unit.

Every expected figure below was worked out by hand from the rules in `rm_core.location_index`, not read back:
percentile = (n - rank) / (n - 1) * 100 with ties sharing the best rank; weights 20/10/15/15/20/20.
"""

from decimal import Decimal

import pytest
from rm_contracts.location_context import TerritoryLevel, TerritoryRef
from rm_core import location_index as li
from rm_core.bdl_metrics import BY_KEY
from rm_core.location_contracts import TerritoryHierarchy
from rm_core.location_index import IndexState, IndicatorSlice, build_index

D = Decimal
L = TerritoryLevel


def ref(tid: str, teryt: str, level: TerritoryLevel, parent: str | None) -> TerritoryRef:
    return TerritoryRef(territory_id=tid, teryt=teryt, name=f"n{tid}", level=level, parent_id=parent)


HIER = TerritoryHierarchy(
    [
        ref("PL", "", L.country, None),
        ref("W1", "01", L.wojewodztwo, "PL"),
        ref("W2", "02", L.wojewodztwo, "PL"),
        ref("PA", "0101", L.powiat, "W1"),
        ref("PB", "0102", L.powiat, "W1"),
        ref("PC", "0201", L.powiat, "W2"),
        ref("g1", "0101011", L.gmina, "PA"),
        ref("g2", "0101022", L.gmina, "PA"),
        ref("g3", "0102013", L.gmina, "PB"),
        ref("g4", "0201011", L.gmina, "PC"),
        ref("g5", "0201022", L.gmina, "PC"),
    ]
)


def sl(values: dict[str, str], year: int = 2024) -> IndicatorSlice:
    return IndicatorSlice(year, {k: D(v) for k, v in values.items()})


def slices() -> dict[str, IndicatorSlice]:
    return {
        "population_total": sl({"g1": "10000", "g2": "20000", "g3": "5000", "g4": "40000", "g5": "10000"}),
        # per 1000: g1 5, g2 2, g3 -2, g4 10, g5 0
        "net_migration": sl({"g1": "50", "g2": "40", "g3": "-10", "g4": "400", "g5": "0"}),
        # per 1000: g1 1, g2 1, g3 -1, g4 2, g5 -2
        "natural_increase": sl({"g1": "10", "g2": "20", "g3": "-5", "g4": "80", "g5": "-20"}),
        "unemployment_share_working_age": sl({"g1": "8", "g2": "8", "g3": "6", "g4": "4", "g5": "4"}, 2025),
        "average_monthly_gross_earnings": sl({"PA": "6000", "PB": "7000", "PC": "8000"}, 2025),
        "regon_entities_per_10k": sl({"g1": "100", "g2": "200", "g3": "150", "g4": "300", "g5": "120"}),
        "own_revenue_per_resident": sl(
            {"g1": "3000", "g2": "2000", "g3": "2500", "g4": "4000", "g5": "3500"}
        ),
    }


@pytest.fixture(autouse=True)
def small_cohorts(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(li, "MIN_COHORT", 3)  # TEST-ONLY: five fictional gminas
    monkeypatch.setattr(li, "MIN_REGION", 2)


def test_scores_ranks_and_contributions_match_the_hand_computation() -> None:
    idx = build_index(HIER, slices())
    assert {g: idx[g].score for g in idx} == {
        "g1": D("40.00"),
        "g2": D("40.00"),
        "g3": D("32.50"),
        "g4": D("100.00"),
        "g5": D("55.00"),
    }
    assert {g: (idx[g].rank, idx[g].of, idx[g].percentile) for g in idx} == {
        "g4": (1, 5, D("100.00")),
        "g5": (2, 5, D("75.00")),
        "g1": (3, 5, D("50.00")),  # a tie shares rank 3 ...
        "g2": (3, 5, D("50.00")),
        "g3": (5, 5, D("0.00")),  # ... and the next rank is 5, not 4
    }
    assert all(idx[g].state is IndexState.ok for g in idx)
    assert (idx["g1"].region_id, idx["g1"].region_rank, idx["g1"].region_of) == ("W1", 1, 3)
    assert (idx["g3"].region_rank, idx["g3"].region_of) == (3, 3)
    assert (idx["g5"].region_id, idx["g5"].region_rank, idx["g5"].region_of) == ("W2", 2, 2)


def test_component_scores_are_oriented_so_that_one_hundred_is_favourable() -> None:
    comp = {c.key: c for c in build_index(HIER, slices())["g4"].components}
    assert comp["net_migration_per_1000"].value == D("10.00")  # 400 / 40000 * 1000
    assert comp["unemployment_share"].score == D("100.00")  # the LOWEST unemployment scores highest
    assert comp["unemployment_share"].rank == 1
    g1 = {c.key: c for c in build_index(HIER, slices())["g1"].components}
    assert (g1["unemployment_share"].rank, g1["unemployment_share"].score) == (4, D("25.00"))
    assert g1["natural_increase_per_1000"].rank == 2  # tied with g2, both second after g4
    assert sum(c.points for c in g1.values()) == D("40.00")  # the contributions add up to the index


def test_a_powiat_grain_component_is_the_powiats_value_and_labelled_a_proxy() -> None:
    comp = {c.key: c for c in build_index(HIER, slices())["g3"].components}
    assert comp["earnings"].proxy is True
    assert comp["earnings"].measured_territory_id == "PB"
    assert comp["earnings"].value == D("7000.00")
    assert comp["business_density"].proxy is False
    assert comp["business_density"].measured_territory_id == "g3"


def test_one_missing_component_renormalises_the_weights_and_is_reported() -> None:
    s = slices()
    del s[
        "unemployment_share_working_age"
    ]  # 15 of 100 weight gone: 85 % available, labour still has earnings
    g1 = build_index(HIER, s)["g1"]
    assert g1.state is IndexState.ok
    assert g1.missing == ("unemployment_share",)
    assert g1.weight_coverage == D("0.85")
    # by hand: (20*75 + 10*75 + 15*25 + 20*0 + 20*50) / 85 = 3625 / 85
    assert g1.score == D("42.65")


def test_a_missing_pillar_means_not_scored_with_the_reason_and_no_rank() -> None:
    s = slices()
    del s["regon_entities_per_10k"]
    g4 = build_index(HIER, s)["g4"]
    assert (g4.state, g4.score, g4.rank) == (IndexState.not_scored, None, None)
    assert any("Przedsiębiorczość" in r for r in g4.reasons)
    assert len(g4.components) == 5  # the components it does have are still shown


def test_too_little_weight_is_not_scored_even_with_every_pillar_present() -> None:
    s = slices()
    del s["unemployment_share_working_age"]
    del s["natural_increase"]
    del s["own_revenue_per_resident"]  # fiscal pillar empty too: also a missing pillar
    g = build_index(HIER, s)["g1"]
    assert g.state is IndexState.not_scored
    assert g.weight_coverage < li.MIN_WEIGHT_COVERAGE


def test_a_gmina_with_no_values_at_all_is_no_data() -> None:
    assert {g.state for g in build_index(HIER, {}).values()} == {IndexState.no_data}


def test_a_cohort_below_the_minimum_gives_a_score_but_no_position(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(li, "MIN_COHORT", 50)
    g4 = build_index(HIER, slices())["g4"]
    assert (g4.state, g4.score, g4.rank, g4.of, g4.percentile) == (
        IndexState.scored_not_ranked,
        D("100.00"),
        None,
        None,
        None,
    )
    assert any("kohorta mniejsza" in r for r in g4.reasons)


def test_a_zero_population_never_divides_and_drops_the_component() -> None:
    s = slices()
    s["population_total"] = sl({"g1": "0", "g2": "20000", "g3": "5000", "g4": "40000", "g5": "10000"})
    g1 = build_index(HIER, s)["g1"]
    assert "net_migration_per_1000" in g1.missing
    assert "natural_increase_per_1000" in g1.missing


def test_competition_ranks_share_the_best_rank_and_skip_after_a_tie() -> None:
    assert li.competition_ranks({"a": D(5), "b": D(5), "c": D(1), "d": D(9)}, larger_is_better=True) == {
        "d": 1,
        "a": 2,
        "b": 2,
        "c": 4,
    }
    assert li.competition_ranks({"a": D(5), "b": D(1)}, larger_is_better=False) == {"b": 1, "a": 2}
    assert li.percentile_from_rank(1, 1) == D(0)  # a cohort of one has no honest percentile


def test_every_component_names_a_registered_metric_with_a_favourable_direction_and_weights_sum_to_100() -> (
    None
):
    for c in li.COMPONENTS:
        assert BY_KEY[c.metric].direction.value in {"higher_is_favorable", "lower_is_favorable"}
        if c.per_thousand_of:
            assert c.per_thousand_of in BY_KEY
    assert sum(c.weight for c in li.COMPONENTS) == 100
