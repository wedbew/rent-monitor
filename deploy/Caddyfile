# The public site (RM-281): TLS, the SPA from /srv/spa and the API behind /api. `SITE_ADDRESS` is the domain; Caddy
# gets and renews the certificate itself. www is only a pointer to the apex (its own certificate and a redirect).
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# The only places the page may load from: itself, and Google sign-in (GIS script, its button iframe and its
	# styles), and the browser error-tracking ingest host when one is configured (`BROWSER_ERRORS_ORIGIN`, RM-280;
	# empty adds nothing). No inline script; no third party not listed here. Paddle.js (#277) adds its hosts through the `PADDLE_CSP_*` values (all empty = billing off = nothing added; the sandbox and live values and the evidence are in docs/PADDLE-SANDBOX-SETUP.md section 4). `PADDLE_CSP_STYLE_ATTR` is the one relaxation Paddle's overlay needs (inline style attributes, never inline style elements or scripts) and stays empty until the owner accepts it. React sets dynamic sizes through the CSSOM, which `style-src` does not block.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client {$PADDLE_CSP_SCRIPT}; style-src 'self' https://accounts.google.com/gsi/style {$PADDLE_CSP_ASSETS}; style-src-attr {$PADDLE_CSP_STYLE_ATTR}; img-src 'self' data: {$PADDLE_CSP_ASSETS}; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/ {$BROWSER_ERRORS_ORIGIN}; frame-src https://accounts.google.com/gsi/ {$PADDLE_CSP_FRAME}; manifest-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# Internal probes are never public (the external monitor uses /api/health). Inside its own `handle`: a bare
	# `respond` runs after the `handle` blocks, so the SPA catch-all would answer these paths first.
	@internal path /healthz /readyz
	handle @internal {
		respond 404
	}

	# Server-sent events must not be buffered.
	@sse path_regexp sse ^/api/audits/[0-9a-f-]+/events$
	handle @sse {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# The API answers every /api path itself, including unknown ones (problem JSON 404): never the SPA.
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# Hashed build assets never change: cached for a year. A missing one is a 404, never index.html (a stale tab
	# then shows the "new version" notice instead of parsing HTML as JavaScript).
	handle /assets/* {
		root * /srv/spa
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app: a real file (icons, theme boot script) or index.html for a deep link. Always
	# revalidated, so a new release is picked up on the next load.
	handle {
		root * /srv/spa
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
