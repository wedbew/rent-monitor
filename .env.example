# Copy to .env and fill in. Never commit .env. Names follow docs/BLUEPRINT.md §4.2.

# --- Public URLs ---
PUBLIC_APP_URL=http://localhost
APP_ENV=development                      # development | test | production

# --- PostgreSQL ---
POSTGRES_DB=rentmonitor
POSTGRES_USER=rentmonitor
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://rentmonitor:change-me@postgres:5432/rentmonitor
PROCRASTINATE_DSN=postgresql://rentmonitor:change-me@postgres:5432/rentmonitor

# --- Auth (Google Identity Services + email magic link) ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
SESSION_COOKIE_NAME=rm_session           # production: __Host-rm_session
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=30

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM="RentMonitor <no-reply@example.invalid>"

# --- Stripe (sandbox keys only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_PASS_30D=
PRO_MONTHLY_AUDIT_ALLOWANCE=40           # placeholder until per-audit COGS is measured
FREE_SIGNUP_CREDITS=3
PAST_DUE_GRACE_DAYS=7

# --- AI / external data ---
OPEN_ROUTER_API_KEY=
OPENROUTER_MONTHLY_BUDGET_USD=50
BDL_API_KEY=
OTODOM_HTTP_BACKEND=curl_cffi
OTODOM_MAX_RPS=1
NOMINATIM_USER_AGENT="RentMonitor/1.0 (set-an-ops-contact)"

# --- Workers ---
WORKER_AUDIT_CONCURRENCY=1
WORKER_BATCH_CONCURRENCY=1
AUDIT_JOB_TIMEOUT_S=900

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_CRON_BACKUP_SLUG=nightly-backup
SENTRY_CRON_CHECKIN_URL=
LOG_LEVEL=INFO
LOG_JSON=true
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=

# --- Backups (Cloudflare R2) and WAL-G ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rentmonitor-backups
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
WALG_S3_PREFIX=s3://rentmonitor-backups/wal
WALG_COMPRESSION_METHOD=zstd
WALG_LIBSODIUM_KEY=

# --- Invoicing (Fakturownia) ---
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=
