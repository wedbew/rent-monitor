# Copy to .env and fill in. Never commit .env. Names follow docs/BLUEPRINT.md §4.2; this file holds NO real values.
# Agents keep this file in sync with the code (.agent/rules/env-example.md). "needs you" = only the owner can supply it
# (see docs/BLOCKERS.md). Everything else works with the defaults below for local development.
#
# Comments go on their own line ABOVE the setting, never after the value. `docker run --env-file`, systemd
# EnvironmentFile and some shells keep a trailing "  # text" as part of the value (found deploying RM-234).

# --- Public URLs ---
# local: http://localhost ; production: https://<your domain>
PUBLIC_APP_URL=http://localhost
# development | test | production
APP_ENV=development
# set by the deploy (image tag / git sha); leave empty locally
RELEASE=

# --- PostgreSQL (local Docker database, see deploy/compose.dev.yml) ---
POSTGRES_IMAGE=postgres:17
# host port; change if 5432 is taken
POSTGRES_PORT=5432
POSTGRES_DB=rentmonitor
POSTGRES_USER=rentmonitor
# any random string locally; 32 random bytes in production
POSTGRES_PASSWORD=change-me
# Host-side tools (make migrate, uv run ...) reach Postgres on localhost; containers use the compose service name instead.
DATABASE_URL=postgresql+psycopg://rentmonitor:change-me@localhost:5432/rentmonitor
PROCRASTINATE_DSN=postgresql://rentmonitor:change-me@localhost:5432/rentmonitor
# your email: `make seed` gives it the admin role
ADMIN_EMAIL=

# --- Auth (Google Identity Services + email magic link) ---
# the OAuth client's ID (not the secret) from Google Cloud Console > Credentials; the secret JSON stays in deploy/ (gitignored)
GOOGLE_CLIENT_ID=
# the OAuth client secret; only used by a server-side code flow, never by the SPA, never logged
GOOGLE_CLIENT_SECRET=
# same value as GOOGLE_CLIENT_ID, used by the SPA build
VITE_GOOGLE_CLIENT_ID=
# base name; production adds the __Host- prefix itself, do not include it
SESSION_COOKIE_NAME=rm_session
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=30

# --- Email (Resend) ---
# private key from resend.com > API Keys; keep empty in this tracked example
RESEND_API_KEY=
# local test sender: account-owner recipient only; production needs a verified domain
MAIL_FROM="RentMonitor <onboarding@resend.dev>"

# --- Stripe (sandbox keys only; implemented after the API endpoints work) ---
# needs you: Stripe test mode > Developers > API keys (sk_test_... only)
STRIPE_SECRET_KEY=
# `stripe listen` prints whsec_... locally
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive
# price_... created in the Stripe sandbox
STRIPE_PRICE_PRO_MONTHLY=
# price_... created in the Stripe sandbox
STRIPE_PRICE_PRO_PASS_30D=
# same as STRIPE_PRICE_PRO_MONTHLY; `make seed` stores it on the pro plan
STRIPE_PRICE_ID_PRO=
# placeholder until per-audit COGS is measured
PRO_MONTHLY_AUDIT_ALLOWANCE=40
FREE_SIGNUP_CREDITS=3
PAST_DUE_GRACE_DAYS=7

# --- AI / external data ---
# needs you: openrouter.ai > Keys (vision stays off when empty)
OPEN_ROUTER_API_KEY=
# hard stop for vision spend
OPENROUTER_MONTHLY_BUDGET_USD=50
# reserved per call until settled with the real cost (placeholder, L-003)
OPENROUTER_CALL_ESTIMATE_USD=0.02
# photo hosts we may fetch (https only); see L-006
IMAGE_HOST_ALLOWLIST=olxcdn.com,otodom.pl
# optional: GUS BDL API key raises the request quota
BDL_API_KEY=
OTODOM_HTTP_BACKEND=curl_cffi
OTODOM_MAX_RPS=1
# put a real contact email: OSM usage policy
NOMINATIM_USER_AGENT="RentMonitor/1.0 (set-an-ops-contact)"

# --- Workers ---
WORKER_AUDIT_CONCURRENCY=1
WORKER_BATCH_CONCURRENCY=1
AUDIT_JOB_TIMEOUT_S=900
# none = every audit fails closed and releases its credit; real = Otodom client + market store (#187)
AUDIT_PROVIDERS=none
# LEGAL[scraping] kill switch: false ends audits at the fetch (no deploy needed, restart the worker)
LEGAL_SCRAPING_ENABLED=true
# needs you: PL 10Y yield as a fraction (ENGINE-SPEC row 9); unset = audits end CONTEXT_UNAVAILABLE
# RISK_FREE_RATE=0.055
# deploy: git short sha of the image to run (compose.prod.yml); rollback = set the previous sha
IMAGE_TAG=local
# needs you: the domain, only for the public profile (Caddy), after DNS (B-005)
# PUBLIC_HOST=
# disabled | paddle; disabled needs no credentials (docs/PADDLE-INTEGRATION.md)
BILLING_PROVIDER=disabled
# sandbox | live; never mix keys across environments
PADDLE_ENVIRONMENT=sandbox
# needs you: Paddle secret API key of that environment (pdl_sdbx_... / pdl_live_...)
# PADDLE_API_KEY=
# needs you: secret of the notification destination
# PADDLE_WEBHOOK_SECRET=
# only while rotating the secret
# PADDLE_WEBHOOK_SECRET_PREVIOUS=
# accepted clock skew of the signature timestamp
PADDLE_WEBHOOK_TOLERANCE_S=5
# processed billing events are purged after this
RETENTION_BILLING_EVENT_DAYS=90
# needs you: public Paddle.js token (Phase 2 checkout), never the API key
# PADDLE_CLIENT_TOKEN=
# needs you: approved pri_... ids of the 1-, 5- and 10-report packs
# PADDLE_PRICE_REPORTS_1=
# PADDLE_PRICE_REPORTS_5=
# PADDLE_PRICE_REPORTS_10=
# needs you: owner-approved gross PLN in grosze; no default price exists
# PADDLE_APPROVED_AMOUNTS=reports_1=...,reports_5=...,reports_10=...
# address-space cap of the engine child process; no secret
AUDIT_CHILD_MEMORY_MB=1024

# --- Retention (GDPR; PROPOSED defaults, counsel confirms: docs/BLOCKERS.md B-012) ---
# days after a session expires
RETENTION_SESSION_DAYS=7
RETENTION_LOGIN_TOKEN_DAYS=1
# raw listing payloads (may contain seller data)
RETENTION_SNAPSHOT_DAYS=30
# Argon2id memory cost for password hashes (OWASP minimum); raise after measuring on the VPS (L-019)
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1
# simultaneous password hashes per API process
PASSWORD_HASH_CONCURRENCY=2
# registration link lifetime
REGISTER_TOKEN_TTL_HOURS=24
# password-reset link lifetime (#205)
RESET_TOKEN_TTL_MINUTES=30
RETENTION_AUDIT_EVENT_DAYS=30

# --- Observability ---
# Better Stack > Errors > Application > Data ingestion: DSN for the Sentry SDK (empty = off; ADR 0009)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Better Stack > Uptime > Heartbeats > nightly backup URL (24 h period)
BETTERSTACK_HEARTBEAT_BACKUP_URL=
# heartbeat pinged by the nightly ledger-vs-balance check, only when there is no mismatch (24 h period)
BETTERSTACK_HEARTBEAT_LEDGER_URL=
# heartbeat pinged by the nightly retention sweep (24 h period)
BETTERSTACK_HEARTBEAT_RETENTION_URL=
# Better Stack > Telemetry > Source > Ingest: private token; log exporter not implemented yet
BETTERSTACK_SOURCE_TOKEN=
# RentMonitor Python source; log exporter not implemented yet
BETTERSTACK_INGESTING_URL=https://s2793691.us-west-2a.betterstackdata.com
LOG_LEVEL=INFO
LOG_JSON=true
# Umami Cloud > Websites > your site > Tracking code (data-website-id); public in page HTML, kept here by name only; empty = analytics off
VITE_UMAMI_WEBSITE_ID=
# Umami Cloud script; frontend is Phase 2
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# --- Backups (Cloudflare R2) and WAL-G ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# optional alias for R2_ACCOUNT_ID in scripts/check_r2_upload.py
S3_ACCOUNT_ID=
# optional R2 API token; script can derive S3 credentials only if token verification succeeds
S3_API_KEY=
R2_BUCKET=rentmonitor-backups
# age public key (age-keygen); keep the private key offline
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
WALG_S3_PREFIX=s3://rentmonitor-backups/wal
WALG_COMPRESSION_METHOD=zstd
# 32-byte key kept in your password manager
WALG_LIBSODIUM_KEY=

# --- Invoicing (Fakturownia) ---
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=
