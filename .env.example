# Copy to .env and fill in. Never commit .env. Names follow docs/BLUEPRINT.md §4.2; this file holds NO real values.
# Agents keep this file in sync with the code (.agent/rules/env-example.md). "needs you" = only the owner can supply it
# (see docs/BLOCKERS.md). Everything else works with the defaults below for local development.

# --- Public URLs ---
PUBLIC_APP_URL=http://localhost          # local: http://localhost ; production: https://<your domain>
APP_ENV=development                      # development | test | production
# RELEASE: set by the deploy (image tag / git sha); leave empty locally
RELEASE=

# --- PostgreSQL (local Docker database, see deploy/compose.dev.yml) ---
POSTGRES_IMAGE=postgres:17
POSTGRES_PORT=5432                       # host port; change if 5432 is taken
CAPTURE_ADMIN_URL=                       # make api-samples: maintenance-database URL (postgresql+psycopg://...); empty = the Compose defaults above
API_SAMPLES_LIVE_AUTHORISED=             # set to 1 only for an owner-authorised `capture_api_samples.py --mode live` run; never in CI
POSTGRES_DB=rentmonitor
POSTGRES_USER=rentmonitor
POSTGRES_PASSWORD=change-me              # any random string locally; 32 random bytes in production
# Host-side tools (make migrate, uv run ...) reach Postgres on localhost; containers use the compose service name instead.
DATABASE_URL=postgresql+psycopg://rentmonitor:change-me@localhost:5432/rentmonitor
PROCRASTINATE_DSN=postgresql://rentmonitor:change-me@localhost:5432/rentmonitor
# ADMIN_EMAIL: your email: `make seed` gives it the admin role
ADMIN_EMAIL=

# --- Auth (Google Identity Services + email magic link) ---
# GOOGLE_CLIENT_ID: the OAuth client's ID (not the secret) from Google Cloud Console > Credentials; the secret JSON stays in deploy/ (gitignored)
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET: the OAuth client secret; only used by a server-side code flow, never by the SPA, never logged
GOOGLE_CLIENT_SECRET=
# VITE_GOOGLE_CLIENT_ID: same value as GOOGLE_CLIENT_ID, used by the SPA build
VITE_GOOGLE_CLIENT_ID=
# VITE_PADDLE_CLIENT_TOKEN: Paddle > Developer tools > Authentication > Client-side tokens (public by design; test_ for the
# sandbox, live_ for production). needs you (B-017). Empty = the SPA offers no purchase. Paddle.js also needs its hosts in the
# Caddy CSP before it can load (L-038).
VITE_PADDLE_CLIENT_TOKEN=
# VITE_PADDLE_ENVIRONMENT: sandbox or production, matching the token
VITE_PADDLE_ENVIRONMENT=sandbox
# PADDLE_CSP_*: the Paddle hosts the Caddy CSP allows (docs/PADDLE-SANDBOX-SETUP.md section 4b). Empty = none (billing off).
# Sandbox: SCRIPT=https://cdn.paddle.com ASSETS="https://cdn.paddle.com https://sandbox-cdn.paddle.com"
# FRAME=https://sandbox-buy.paddle.com STYLE_ATTR='unsafe-inline' (the last one is an owner decision: needs you)
PADDLE_CSP_SCRIPT=
PADDLE_CSP_ASSETS=
PADDLE_CSP_FRAME=
PADDLE_CSP_STYLE_ATTR=
# VITE_SENTRY_DSN: Better Stack > Errors > the browser application > Data ingestion (a public ingest key, embedded in the
# SPA). needs you. Empty = no browser error reporting and no SDK loaded (RM-280). Its host must be in the Caddy CSP
# connect-src (BROWSER_ERRORS_ORIGIN below).
VITE_SENTRY_DSN=
# VITE_RELEASE / VITE_ENVIRONMENT: set by the web image build (IMAGE_TAG, "production"); local builds say "local"/"development"
VITE_RELEASE=
VITE_ENVIRONMENT=
# BROWSER_ERRORS_ORIGIN: scheme and host of VITE_SENTRY_DSN (e.g. https://<ingest host>), added to the CSP connect-src
BROWSER_ERRORS_ORIGIN=
SESSION_COOKIE_NAME=rm_session           # base name; production adds the __Host- prefix itself, do not include it
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=30

# --- Email (Resend) ---
# RESEND_API_KEY: private key from resend.com > API Keys; keep empty in this tracked example
RESEND_API_KEY=
MAIL_FROM="Renti <onboarding@resend.dev>"   # local test sender: account-owner recipient only; production needs a verified domain

# --- Stripe (sandbox keys only; implemented after the API endpoints work) ---
# STRIPE_SECRET_KEY: needs you: Stripe test mode > Developers > API keys (sk_test_... only)
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: `stripe listen` prints whsec_... locally
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive
# STRIPE_PRICE_PRO_MONTHLY: price_... created in the Stripe sandbox
STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_PASS_30D: price_... created in the Stripe sandbox
STRIPE_PRICE_PRO_PASS_30D=
# STRIPE_PRICE_ID_PRO: same as STRIPE_PRICE_PRO_MONTHLY; `make seed` stores it on the pro plan
STRIPE_PRICE_ID_PRO=
PRO_MONTHLY_AUDIT_ALLOWANCE=40           # placeholder until per-audit COGS is measured
FREE_SIGNUP_CREDITS=3
PAST_DUE_GRACE_DAYS=7

# --- AI / external data ---
# OPEN_ROUTER_API_KEY: needs you: openrouter.ai > Keys (vision stays off when empty)
OPEN_ROUTER_API_KEY=
OPENROUTER_MONTHLY_BUDGET_USD=50         # hard stop for vision spend
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite   # vision model id on openrouter.ai/models; placeholder until quality is measured (L-003)
OPENROUTER_CALL_ESTIMATE_USD=0.02        # FALLBACK hold per call, used only when openrouter.ai/models has no price for the model; normally the hold is priced from that catalog and replaced by the real cost
IMAGE_HOST_ALLOWLIST=olxcdn.com,otodom.pl  # photo hosts we may fetch (https only); see L-006
# BDL_API_KEY: optional: GUS BDL API key raises the request quota
BDL_API_KEY=
LOCATION_REFERENCE_VERSION=1              # frozen GUS BDL territorial reference; bump only when the unit lists change (RM-48)
BDL_REFRESH_CRON=30 3 * * 1              # UTC, weekly refresh of the BDL context (finished runs are skipped, RM-48)
BDL_REQUESTS_PER_MINUTE=60               # our own cap on GUS BDL requests, shared by all workers; the key's live quota is 50,000 per 7 days (header x-rate-limit, checked 2026-10-20, RM-48)
OTODOM_HTTP_BACKEND=curl_cffi
OTODOM_MAX_RPS=1
NOMINATIM_USER_AGENT="Renti/1.0 (set-an-ops-contact)"   # put a real contact email: OSM usage policy

# --- Workers ---
WORKER_AUDIT_CONCURRENCY=1
WORKER_BATCH_CONCURRENCY=1
AUDIT_JOB_TIMEOUT_S=900
AUDIT_PROVIDERS=none                      # none = every audit fails closed and releases its credit; real = Otodom client + market store (#187)
LEGAL_IMAGES_ENABLED=true                 # LEGAL[images] kill switch: false skips photo download and vision (audits end degraded); restart the worker
LEGAL_SCRAPING_ENABLED=true               # LEGAL[scraping] kill switch: false ends audits at the fetch (no deploy needed, restart the worker)
OTODOM_MARKET_IMPORT_ENABLED=true         # LEGAL[scraping] kill switch for the market corpus import and its summaries (audits unaffected); restart the worker
OTODOM_MARKET_NIGHTLY_CRON="0 1 * * *"    # UTC, five fields (docs/OTODOM-NIGHTLY-IMPORT.md section 7); read at worker start, restart after changing
OTODOM_MARKET_SUMMARY_CRON="30 5 * * *"  # UTC, five fields: daily asking-rent summaries (read at worker start; restart after changing)
OTODOM_MARKET_NIGHT_WINDOW_END_UTC=05:00  # HH:MM UTC, before 12:00: no new Otodom page requests from here to 12:00; unfinished work stays resumable
OTODOM_MARKET_ARCHIVE_DAYS=90             # policy version: only 90 is accepted (database CHECKs); not a provider inactivity claim
OTODOM_MARKET_OVERLAP_MINUTES=60          # recovery margin, 0-1440
OTODOM_MARKET_REQUEST_BUDGET=3000         # pages per run; exceeding it leaves the run incomplete, never an implicit completeness cap
OTODOM_MARKET_FRESH_HOURS=36              # refresh age up to this is fresh
OTODOM_MARKET_STALE_HOURS=72              # older than this (or an unresolved gap) is stale; must exceed FRESH_HOURS
OTODOM_MARKET_CATALOGUE_VERSION=1         # catalogue version the dispatcher and summaries read
# RISK_FREE_RATE=0.055                    # needs you: fallback PL 10Y yield as a fraction, used only when no fresh ECB value is stored (RM-210); unset and no fresh ECB value = audits end CONTEXT_UNAVAILABLE
IMAGE_TAG=local                           # deploy: git short sha of the image to run (compose.prod.yml); rollback = set the previous sha
# PUBLIC_HOST=                            # needs you: the domain, only for the public profile (Caddy), after DNS (B-005)
BILLING_PROVIDER=disabled                 # disabled | paddle; disabled needs no credentials (docs/PADDLE-INTEGRATION.md)
PADDLE_ENVIRONMENT=sandbox                # sandbox | live; never mix keys across environments
# PADDLE_API_KEY=                         # needs you: Paddle secret API key of that environment (pdl_sdbx_... / pdl_live_...)
# PADDLE_WEBHOOK_SECRET=                  # needs you: secret of the notification destination
# PADDLE_WEBHOOK_SECRET_PREVIOUS=         # only while rotating the secret
PADDLE_WEBHOOK_TOLERANCE_S=5              # accepted clock skew of the signature timestamp
RETENTION_BILLING_EVENT_DAYS=90           # processed billing events are purged after this
# PADDLE_CLIENT_TOKEN=                    # needs you: public Paddle.js token (Phase 2 checkout), never the API key
# PADDLE_PRICE_REPORTS_1=                 # needs you: approved pri_... ids of the 1-, 5- and 10-report packs
# PADDLE_PRICE_REPORTS_5=
# PADDLE_PRICE_REPORTS_10=
# PADDLE_APPROVED_AMOUNTS=reports_1=...,reports_5=...,reports_10=...   # needs you: owner-approved gross PLN in grosze; no default price exists
AUDIT_CHILD_MEMORY_MB=1024                # address-space cap of the engine child process; no secret

# --- Retention (GDPR; PROPOSED defaults, counsel confirms: docs/BLOCKERS.md B-012) ---
RETENTION_SESSION_DAYS=7                 # days after a session expires
RETENTION_LOGIN_TOKEN_DAYS=1
RETENTION_SNAPSHOT_DAYS=30               # raw listing payloads (may contain seller data)
PASSWORD_ARGON2_MEMORY_KIB=19456          # Argon2id memory cost for password hashes (OWASP minimum); raise after measuring on the VPS (L-019)
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1
PASSWORD_HASH_CONCURRENCY=2               # simultaneous password hashes per API process
REGISTER_TOKEN_TTL_HOURS=24               # registration link lifetime
RESET_TOKEN_TTL_MINUTES=30                # password-reset link lifetime (#205)
RETENTION_AUDIT_EVENT_DAYS=30

# --- Observability ---
# SENTRY_DSN: Better Stack > Errors > Application > Data ingestion: DSN for the Sentry SDK (empty = off; ADR 0009)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# BETTERSTACK_HEARTBEAT_BACKUP_URL: Better Stack > Uptime > Heartbeats > nightly backup URL (24 h period)
BETTERSTACK_HEARTBEAT_BACKUP_URL=
# BETTERSTACK_HEARTBEAT_LEDGER_URL: heartbeat pinged by the nightly ledger-vs-balance check, only when there is no mismatch (24 h period)
BETTERSTACK_HEARTBEAT_LEDGER_URL=
# BETTERSTACK_HEARTBEAT_RETENTION_URL: heartbeat pinged by the nightly retention sweep (24 h period)
BETTERSTACK_HEARTBEAT_RETENTION_URL=
# BETTERSTACK_SOURCE_TOKEN: Better Stack > Telemetry > Source > Ingest: private token; log exporter not implemented yet
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_URL=https://s2793691.us-west-2a.betterstackdata.com  # Renti Python source; log exporter not implemented yet
APP_NAME=Renti                            # product name shown in mail subjects and the API docs; not a secret
LOG_LEVEL=INFO
LOG_JSON=true
# VITE_UMAMI_WEBSITE_ID: Umami Cloud > Websites > your site > Tracking code (data-website-id); public in page HTML, kept here by name only; empty = analytics off
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js   # Umami Cloud script; frontend is Phase 2

# --- Backups (Cloudflare R2) and WAL-G ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3_ACCOUNT_ID: optional alias for R2_ACCOUNT_ID in scripts/check_r2_upload.py
S3_ACCOUNT_ID=
# S3_API_KEY: optional R2 API token; script can derive S3 credentials only if token verification succeeds
S3_API_KEY=
R2_BUCKET=rentmonitor-backups
# BACKUP_AGE_RECIPIENT: age public key (age-keygen); keep the private key offline
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
WALG_S3_PREFIX=s3://rentmonitor-backups/wal
WALG_COMPRESSION_METHOD=zstd
# WALG_LIBSODIUM_KEY: 32-byte key kept in your password manager
WALG_LIBSODIUM_KEY=

# --- Invoicing (Fakturownia) ---
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=
