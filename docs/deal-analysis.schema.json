      "type": "string"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EquipmentObservation": {
      "description": "One piece of equipment or fit-out the model saw, linked to the image it came from (G-02).\n\nFactual evidence only: it never feeds a number (invariant 4). `media_ordinal` is the position in the\nselected media list (photos in listing order, then floor plans), the `ordinal` of the media manifest.\nLEGAL[images]: derived from listing photos and plans sent to a third party (RM-387)\nLEGAL[republication]: shown back to users, so bounded and stripped of control characters (RM-387)\nGDPR[processor]: produced by the vision model behind OpenRouter (RM-387)",
      "properties": {
        "confidence": {
          "title": "Confidence",
          "type": "string"
        },
        "item": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "media_ordinal": {
          "anyOf": [
            {
              "maximum": 26,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Ordinal"
        },
        "provenance": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unattributed"
        },
        "sale_status": {
          "$ref": "#/$defs/SaleStatus",
          "default": "unknown"
        }
      },
      "required": [
        "confidence",
        "item",
        "media_ordinal",
        "provenance",
        "sale_status"
      ],
      "title": "EquipmentObservation",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "photo",
        "floor_plan",
        "unattributed"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
