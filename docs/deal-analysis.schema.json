  "$id": "urn:rentmonitor:deal-analysis:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The canonical result. `model_dump_json()` is what is stored, shown through the API and rendered\nto Markdown.",
  "properties": {
    "assumptions_version": {
      "default": "2026-10-12.2",
      "description": "Version of the numeric assumptions the engine used",
      "title": "Assumptions Version",
      "type": "string"
    },
    "capex": {
      "$ref": "#/$defs/CapexEstimate",
      "description": "Renovation cost estimate before any vision adjustment"
    },
    "capex_used_pln": {
      "description": "CAPEX after the clamped vision adjustment (PLN, string)",
      "title": "Capex Used Pln",
      "type": "string"
    },
    "cash_flow": {
      "$ref": "#/$defs/CashFlowResult",
      "description": "Ten-year cash flows and returns; computed in Python only"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "description": "The weakest of the input confidences"
    },
    "engine_version": {
      "default": "0.1.0",
      "description": "Engine release that produced the numbers",
      "title": "Engine Version",
      "type": "string"
    },
    "legal": {
      "$ref": "#/$defs/LegalAssessment",
      "description": "Residential / VAT-sale / non-residential classification"
    },
    "listing": {
      "$ref": "#/$defs/Listing",
      "description": "The advert as extracted: asking price, never a deed price"
    },
    "ownership": {
      "$ref": "#/$defs/OwnershipAssessment",
      "description": "Whole or fractional ownership; fractional never gets here"
    },
    "rent": {
      "$ref": "#/$defs/RentApplied",
      "description": "Market rent used, with its basis, haircut and confidence"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Version of this document's shape. Additive changes keep it; a removed or renamed field, a changed type or a narrowed enum bumps it (docs/REPORT-SCHEMA.md)",
      "title": "Schema Version",
      "type": "integer"
    },
    "valuation": {
      "$ref": "#/$defs/MaxBidResult",
      "description": "Max Bid and the grade; a null value means 'not computed'"
    },
    "vision": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisionRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the photos changed, or null when no vision answer was used (a degraded audit)"
    },
    "warnings": {
      "default": [],
      "description": "Stable codes for missing or doubtful inputs; they lower confidence",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "assumptions_version",
    "capex",
    "capex_used_pln",
    "cash_flow",
    "confidence",
    "engine_version",
    "legal",
    "listing",
    "ownership",
    "rent",
    "schema_version",
    "valuation",
    "vision",
    "warnings"
  ],
  "title": "DealAnalysis",
  "type": "object",
  "x-schema-version": 1
}
