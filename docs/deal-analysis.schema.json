            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Floor Plan Urls",
          "type": "array"
        },
        "heating": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heating"
        },
        "kind": {
          "const": "SALE",
          "title": "Kind",
          "type": "string"
        },
        "latitude": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "location_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "pattern": "^[a-z0-9-]+(/[a-z0-9-]+){0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "longitude": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modified At"
        },
        "otodom_id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Otodom Id",
          "type": "string"
        },
        "photo_urls": {
          "default": [],
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Photo Urls",
          "type": "array"
        },
        "price_pln": {
          "title": "Price Pln",
          "type": "string"
        },
        "rooms": {
          "maximum": 50,
          "minimum": 1,
          "title": "Rooms",
          "type": "integer"
        },
        "street": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Street"
        },
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "windows": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Windows"
        }
      },
      "required": [
        "admin_fee_pln",
        "area_m2",
        "build_year",
        "building_floors",
        "building_ownership",
        "building_type",
        "city",
        "created_at",
        "deposit_pln",
        "description",
        "floor",
        "floor_plan_urls",
        "heating",
        "kind",
        "latitude",
        "location_id",
        "longitude",
        "modified_at",
        "otodom_id",
        "photo_urls",
        "price_pln",
        "rooms",
        "street",
        "title",
        "url",
        "warnings",
        "windows"
      ],
      "title": "Listing",
      "type": "object"
