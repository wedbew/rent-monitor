          "default": [],
          "items": {
            "$ref": "#/$defs/EquipmentObservation"
          },
          "maxItems": 40,
          "title": "Equipment",
          "type": "array"
        },
        "floor_plan_text": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Plan Text"
        },
        "model": {
          "maxLength": 120,
          "title": "Model",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "photos_excluded": {
          "title": "Photos Excluded",
          "type": "integer"
        },
        "photos_total": {
          "title": "Photos Total",
          "type": "integer"
        },
        "prompt_version": {
          "maxLength": 40,
          "title": "Prompt Version",
          "type": "string"
        },
        "rent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Applied"
            },
            {
              "type": "null"
            }
          ]
        }
