    "VisionRecord": {
      "additionalProperties": false,
      "description": "Everything needed to reproduce an audit without the model: provenance plus proposed and applied\nadjustments.",
      "properties": {
        "capex": {
          "anyOf": [
            {
              "$ref": "#/$defs/Applied"
            },
            {
              "type": "null"
            }
          ]
        },
