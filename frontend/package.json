{
  "name": "renti-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "generate:api": "node generate-api.mjs",
    "check:api": "node generate-api.mjs --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "vite build",
    "check:dist": "node check-dist.mjs",
    "preview": "vite preview",
    "check": "pnpm check:api && pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm test && pnpm build && pnpm check:dist && pnpm check:fixtures-vs-samples",
    "check:fixtures-vs-samples": "node check-fixtures-vs-samples.mjs",
    "test:e2e": "E2E_COVERAGE=enforce playwright test",
    "test:e2e:journey": "E2E_LANE=journey playwright test",
    "test:e2e:browsers": "E2E_BROWSERS=all playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/browser": "11.6.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
