{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./**/*.key)",
      "Read(./**/client_secret*.json)",
      "Read(./**/*.apps.googleusercontent.com.json)",
      "Read(./**/service-account*.json)",
      "Bash(stripe*--live*)",
      "Bash(git push --force*)",
      "Bash(git push origin main*)",
      "Bash(git push origin staging*)",
      "Bash(gh pr merge*--admin*)"
    ],
    "ask": [
      "Bash(gh repo edit*visibility*)",
      "Bash(gh repo delete*)",
      "Edit(./tests/**/test_invariant_*)",
      "Write(./tests/**/test_invariant_*)",
      "Edit(./migrations/**)",
      "Write(./migrations/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.agent/agents.md)",
      "Bash(ovh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.py$' | xargs -r uv run --quiet ruff format --quiet"
          }
        ]
      }
    ]
  }
}
